# Copia este archivo como ".env" y rellena con tus datos reales.
# .env está en .gitignore y NO debe subirse al repositorio.

# ---------- Base de datos ----------
DATABASE_URL=postgresql+psycopg2://ecoplant:tu_password_aqui@localhost:5432/ecoplant

# ---------- JWT ----------
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- MQTT (mTLS, misma CA que el resto de la plataforma) ----------
MQTT_HOST=192.168.1.140
MQTT_PORT=8883
MQTT_CA_CERT_PATH=/etc/mosquitto/ca_certificates/ca.crt
MQTT_CLIENT_CERT_PATH=/home/piluis/certs/backend-api.crt
MQTT_CLIENT_KEY_PATH=/home/piluis/certs/backend-api.key

# ---------- InfluxDB ----------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=EcoPlant Platform
INFLUXDB_BUCKET=macetero_iot
# Token de SOLO LECTURA, distinto del que usa Node-RED (que tiene escritura)
INFLUXDB_TOKEN=tu_token_de_solo_lectura_aqui
