#pragma once

// Copia este archivo como "secrets.h" y rellena con tus datos reales.
// secrets.h está en .gitignore y NO debe subirse al repositorio.

// ---------- WiFi ----------
// WIFI_SSID/WIFI_PASS ya no hacen falta aquí: el WiFi se configura ahora
// por el portal cautivo de WiFiManager (ver connectWiFi() en el .ino),
// que guarda las credenciales él solo en la NVS del ESP32. Ver la sección
// "Configuración previa" del README para el flujo completo.

// ---------- MQTT: certificado de la CA que firmó el broker ----------
// Con esto el dispositivo verifica que se conecta al broker legítimo.
static const char CA_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
...contenido de ca.crt...
-----END CERTIFICATE-----
)EOF";

// ---------- MQTT: identidad del dispositivo (mTLS) ----------
// La identidad ya no se demuestra con usuario/contraseña, sino con este
// certificado de cliente, firmado por la CA propia con CN = DEVICE_ID.
// El broker lo valida contra ca.crt y usa el CN como usuario (ACL) —
// ver "Certificados de cliente (mTLS)" en platform/README.md.
static const char CLIENT_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
...contenido de macetero01.crt...
-----END CERTIFICATE-----
)EOF";

static const char CLIENT_KEY[] PROGMEM = R"EOF(
-----BEGIN PRIVATE KEY-----
...contenido de macetero01.key...
-----END PRIVATE KEY-----
)EOF";
