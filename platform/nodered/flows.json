    {
        "id": "8eac81157e34c2f2",
        "type": "function",
        "z": "8627a5733f13f310",
        "g": "ef6ac824f908c327",
        "name": "Leer horario actual",
        "func": "let config = global.get('config_maceteros') || {};\nlet horario = config.macetero01 || { horaInicio: 8, horaFin: 21 };\n\nlet msgInicio = { payload: horario.horaInicio, topic: \"horaInicio\" };\nlet msgFin = { payload: horario.horaFin, topic: \"horaFin\" };\n\nreturn [msgInicio, msgFin];",
