    {
        "id": "102f974ae39ce9b1",
        "type": "function",
        "z": "8627a5733f13f310",
        "g": "3aa9676a5b88f14a",
        "name": "Decisión riego",
        "func": "let deviceId = msg.payload.device_id || msg.topic.split('/')[1];\n\nlet config = global.get('config_maceteros') || {};\nlet cfg = config[deviceId];\n\nif (!cfg) {\n    node.warn('Sin configuración para ' + deviceId + ', no se evalúa riego');\n    return null;\n}\n\nlet humedad = msg.payload.humedad_suelo;\nlet hora = new Date().getHours();\n\nlet riegosConfirmados = global.get('ultimoRiegoConfirmado') || {};\nlet ultimoRiego = riegosConfirmados[deviceId] ? riegosConfirmados[deviceId].recibidoEn : 0;\nlet horasDesdeUltimoRiego = (Date.now() - ultimoRiego) / (1000 * 60 * 60);\n\nlet dentroHorario = hora >= cfg.horaInicio && hora < cfg.horaFin;\nlet necesitaRiego = humedad < cfg.humedadMin;\nlet haPasadoTiempo = horasDesdeUltimoRiego >= 24;\n\nnode.status({\n    fill: necesitaRiego ? \"blue\" : \"grey\",\n    shape: \"dot\",\n    text: deviceId + \" \" + humedad + \"% / \" + cfg.humedadMin + \"%\"\n});\n\nlet pendientes = global.get('riegoPendiente') || {};\nlet ordenPendiente = pendientes[deviceId] || 0;\nlet segundosDesdeOrden = (Date.now() - ordenPendiente) / 1000;\n\nif (necesitaRiego && dentroHorario && haPasadoTiempo && segundosDesdeOrden > 60) {\n    pendientes[deviceId] = Date.now();\n    global.set('riegoPendiente', pendientes);\n    node.warn('RIEGO AUTO ' + deviceId + ': ' + humedad + '% < ' + cfg.humedadMin + '%');\n    return {\n        payload: \"REGAR\",\n        topic: \"maceteros/\" + deviceId + \"/comando\"\n    };\n}\n\nreturn null;",
