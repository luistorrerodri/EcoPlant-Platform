    {
        "id": "39bc0b0d71bd0311",
        "type": "function",
        "z": "8627a5733f13f310",
        "g": "3aa9676a5b88f14a",
        "name": "Procesar estado dispositivo",
        "func": "let deviceId = msg.topic.split('/')[1];\nlet datos = msg.payload;\n\n// Mensaje de presencia (online/offline)\nif (datos.online !== undefined) {\n    let estado = global.get('estado_dispositivos') || {};\n    estado[deviceId] = {\n        online: datos.online,\n        ultimoCambio: Date.now()\n    };\n    global.set('estado_dispositivos', estado);\n\n    node.status({\n        fill: datos.online ? \"green\" : \"red\",\n        shape: \"dot\",\n        text: deviceId + (datos.online ? \" online\" : \" OFFLINE\")\n    });\n\n    if (!datos.online) {\n        node.warn('DISPOSITIVO DESCONECTADO: ' + deviceId);\n    }\n    return null;\n}\n\n// Confirmación de riego ejecutado\nif (datos.evento === \"riego_completado\") {\n    let riegos = global.get('ultimoRiegoConfirmado') || {};\n    riegos[deviceId] = {\n        timestamp: datos.timestamp,\n        duracion_ms: datos.duracion_ms,\n        recibidoEn: Date.now()\n    };\n    global.set('ultimoRiegoConfirmado', riegos);\n\n    node.status({\n        fill: \"blue\",\n        shape: \"dot\",\n        text: \"riego confirmado \" + deviceId + \" (\" + datos.duracion_ms + \"ms)\"\n    });\n\n    node.warn('RIEGO CONFIRMADO por ' + deviceId + ': ' + datos.duracion_ms + 'ms');\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
