    {
        "id": "633a82bdc39b77e3",
        "type": "function",
        "z": "8627a5733f13f310",
        "g": "3aa9676a5b88f14a",
        "name": "Estados Planta",
        "func": "let estado = msg.payload;\n\nif (estado === \"SECO\") {\n    msg.payload = \"🔴 SECO\";\n}\nelse if (estado === \"NECESITA_RIEGO\") {\n    msg.payload = \"🟠 NECESITA RIEGO\";\n}\nelse if (estado === \"OK\") {\n    msg.payload = \"🟢 OK\";\n}\nelse {\n    msg.payload = \"🔵 HUMEDO\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 940,
        "wires": [
            []
        ]
    },
    {
        "id": "b32c4dd6d2e5a779",
        "type": "function",
        "z": "8627a5733f13f310",
        "g": "3aa9676a5b88f14a",
        "name": "Formatear para InfluxDB",
        "func": "let deviceId = msg.payload.device_id || msg.topic.split('/')[1];\nlet config = global.get('config_maceteros') || {};\nlet cfg = config[deviceId];\n\nfunction calcularEstado(humedad, minH, maxH) {\n    // Margen simetrico por debajo del minimo y por encima del maximo,\n    // proporcional al propio rango configurado - un cactus (rango\n    // estrecho) tiene margenes de SECO/EXCESO mas ajustados que un\n    // helecho (rango ancho), en vez de un numero fijo igual para todos.\n    // Si se cambia esta formula, cambiarla tambien en soilStatus() del\n    // firmware para que la pantalla y la app no diverjan.\n    let margen = (maxH - minH) * 0.4;\n    if (humedad < minH - margen) return \"SECO\";\n    if (humedad < minH) return \"NECESITA_RIEGO\";\n    if (humedad <= maxH) return \"OK\";\n    if (humedad <= maxH + margen) return \"HUMEDO\";\n    return \"EXCESO_AGUA\";\n}\n\n// Sin config todavia (dispositivo recien reclamado, antes del primer\n// sondeo de 60s) - se usan los umbrales originales como red de\n// seguridad, no se rompe el dato.\nlet estado = cfg\n    ? calcularEstado(msg.payload.humedad_suelo, cfg.humedadMin, cfg.humedadMax)\n    : msg.payload.estado;\n\nlet fields = {\n    humedad_suelo: msg.payload.humedad_suelo,\n    humedad_suelo_raw: msg.payload.humedad_suelo_raw,\n    temp_aire: msg.payload.temp_aire,\n    temp_suelo: msg.payload.temp_suelo,\n    estado: estado\n};\n\n// presion y humedad_ambiente dependen del sensor de ambiente de cada\n// dispositivo (BMP280 da presion, DHT22 da humedad_ambiente, ninguno\n// da los dos) - solo se escribe el campo si el dispositivo lo publico\n// de verdad, nunca con un valor por defecto.\nif (msg.payload.presion !== undefined) {\n    fields.presion = msg.payload.presion;\n}\nif (msg.payload.humedad_ambiente !== undefined) {\n    fields.humedad_ambiente = msg.payload.humedad_ambiente;\n}\n\nmsg.payload = [fields, { device_id: deviceId }];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
