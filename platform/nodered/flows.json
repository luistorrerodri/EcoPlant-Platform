    {
        "id": "bbf9e403ff180c41",
        "type": "function",
        "z": "8627a5733f13f310",
        "g": "ef6ac824f908c327",
        "name": "Guardar horario",
        "func": "let config = global.get('config_maceteros') || {};\nif (!config.macetero01) config.macetero01 = {};\n\nif (msg.topic === \"horaInicio\") {\n    config.macetero01.horaInicio = msg.payload;\n} else if (msg.topic === \"horaFin\") {\n    config.macetero01.horaFin = msg.payload;\n}\n\nglobal.set('config_maceteros', config);\nnode.status({ fill: \"green\", shape: \"dot\", text: \"inicio:\" + config.macetero01.horaInicio + \" fin:\" + config.macetero01.horaFin });\nreturn msg;",
